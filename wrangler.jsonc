{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-expense",
  "main": "cloudflare_worker/main.py",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_NAME": "我的记账"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-expense-db",
      "database_id": "ebb8cc76-1564-49fa-9eb0-9b0ca075652d"
    }
  ]
}
